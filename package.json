{
  "name": "dtalite",
  "version": "4.0.0",
  "description": "DownThemAll! lite - The mass downloader WebExtension",
  "main": "main.js",
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GlacierEQ/downthemall.git"
  },
  "bugs": {
    "url": "https://github.com/GlacierEQ/downthemall/issues"
  },
  "homepage": "https://github.com/GlacierEQ/downthemall#readme",
  "keywords": [
    "webextension",
    "downloader",
    "firefox",
    "chrome",
    "browser-extension",
    "download-manager"
  ],
  "scripts": {
    "build": "util/build.py",
    "build:cleanup": "rm -rf bundles web-ext-artifacts",
    "build:bundles": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "build:regexps": "node util/makexregexps.js > data/xregexps.json",
    "dev": "concurrently \"yarn watch\" \"yarn webext\"",
    "lint": "eslint . --ext .ts,.js --fix",
    "lint:check": "eslint . --ext .ts,.js",
    "pretest": "yarn build:regexps",
    "stats": "cloc --vcs=git --exclude-lang=Markdown,SVG",
    "test": "LANG=en mocha -r ts-node/register tests/**/*.test.ts",
    "test:coverage": "nyc yarn test",
    "type-check": "tsc --noEmit",
    "watch": "webpack --watch --mode=development",
    "webext": "web-ext run -i 'lib/*' -i '**/node_modules/**' --bc -p ../dtalite.p --keep-profile-changes",
    "webext:build": "web-ext build --overwrite-dest"
  },
  "author": {
    "name": "Nils Maier",
    "email": "nils@downthemall.org",
    "url": "https://downthemall.org"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.8",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "chai": "^5.1.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.1",
    "mocha": "^10.7.3",
    "nyc": "^17.1.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "xregexp": "^5.1.1"
  },
  "dependencies": {
    "@types/psl": "^1.1.3",
    "@types/whatwg-mimetype": "^4.0.0",
    "localforage": "^1.10.0",
    "psl": "^1.9.0",
    "webextension-polyfill": "^0.12.0",
    "whatwg-mimetype": "^4.0.0"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "tests/**/*",
      "bundles/**/*",
      "web-ext-artifacts/**/*"
    ],
    "reporter": [
      "html",
      "text"
    ],
    "all": true
  }
}